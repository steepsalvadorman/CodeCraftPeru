---
import Logo from './Logo.astro';
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <div class="footer-logo-row">
        <Logo variant="full" size="lg" href="/" />
      </div>
      <p class="brand-description">
        Desarrollador frontend freelance especializado en sistemas integrados de gestión web para empresas. ERP, inventarios, CRM y dashboards a medida.
      </p>
    </div>

    <div class="footer-links-grid">
      <div class="footer-links-col">
        <h6 class="col-title">Servicios</h6>
        <ul class="col-list">
          <li><a href="#servicios">Sistema ERP Web</a></li>
          <li><a href="#servicios">Control de Inventarios</a></li>
          <li><a href="#servicios">CRM & Ventas</a></li>
          <li><a href="#servicios">Dashboards & BI</a></li>
        </ul>
      </div>

      <div class="footer-links-col">
        <h6 class="col-title">Navegación</h6>
        <ul class="col-list">
          <li><a href="#hero">Inicio</a></li>

          <li><a href="#proceso">Proceso</a></li>
          <li><a href="#cotizar">Cotizar</a></li>
        </ul>
      </div>

      <div class="footer-links-col">
        <h6 class="col-title">Contacto</h6>
        <ul class="col-list">
          <li><a href="mailto:steepbsm@gmail.com">steepbsm@gmail.com</a></li>
          <li><a href="https://github.com/steepsalvadorman" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><span class="footer-text">Lima, Perú 🇵🇪</span></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-container">
      <p class="copyright">
        &copy; {new Date().getFullYear()} SteepDev. Todos los derechos reservados.
      </p>
      <div class="system-status">
        <span class="status-dot"></span>
        <span class="status-text">DISPONIBLE PARA PROYECTOS</span>
      </div>
    </div>
  </div>
</footer>
