<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <a href="#" class="footer-logo">
        <span class="logo-code">&lt;</span>CodeCraft<span class="logo-country">Perú</span><span class="logo-code">&gt;</span>
      </a>
      <p class="brand-description">
        Ingeniería de software de alta gama y arquitecturas de telemetría crítica para la gran minería e industria pesada.
      </p>
      
      <div class="tech-stack-badges">
        <span class="badge" title="Backend Engine">Spring Boot</span>
        <span class="badge" title="Frontend System">Angular</span>
        <span class="badge" title="Edge & Telemetry">Rust</span>
      </div>
    </div>

    <div class="footer-links-grid">
      <div class="footer-links-col">
        <h6 class="col-title">Soluciones PaaS</h6>
        <ul class="col-list">
          <li><a href="#detalles-weighflow">WeighFlow IoT</a></li>
          <li><a href="#detalles-ventiflow">VentiFlow IoT</a></li>
          <li><a href="#detalles-loadgrade">LoadGrade PaaS</a></li>
          <li><a href="#detalles-tiretrack">TireTrack IoT</a></li>
        </ul>
      </div>

      <div class="footer-links-col">
        <h6 class="col-title">Ingeniería</h6>
        <ul class="col-list">
          <li><a href="#" class="disabled-link">API Sandbox <span class="tag-soon">Próximamente</span></a></li>
          <li><a href="#" class="disabled-link">Documentación Técnica</a></li>
          <li><a href="#" class="disabled-link">Arquitectura de Integración</a></li>
          <li><a href="https://github.com" target="_blank" rel="noopener noreferrer">Repositorio Oficial</a></li>
        </ul>
      </div>

      <div class="footer-links-col">
        <h6 class="col-title">Contacto & Soporte</h6>
        <ul class="col-list">
          <li><a href="#contacto">Solicitud de Factibilidad</a></li>
          <li><a href="mailto:steepbsm@gmail.com">Soporte B2B</a></li>
          <li><span class="footer-text">Lima, Perú</span></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-container">
      <p class="copyright">
        &copy; {new Date().getFullYear()} CodeCraft Perú. Todos los derechos reservados.
      </p>
      <div class="system-status">
        <span class="status-dot"></span>
        <span class="status-text">SYSTEM STATUS: ONLINE [ALL PAAS SERVICES COMPLIANT]</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: rgba(7, 9, 14, 0.9);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 80px 50px 30px 50px;
    position: relative;
    z-index: 10;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1.8fr;
    gap: 60px;
    margin-bottom: 60px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }

  .footer-logo {
    font-size: 24px;
    font-weight: 800;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .logo-code {
    color: rgb(220, 68, 68);
    font-family: 'JetBrains Mono', monospace;
  }

  .logo-country {
    background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .brand-description {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 320px;
  }

  .tech-stack-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    color: #eaeaea;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 4px 10px;
    border-radius: 6px;
    transition: var(--transition-smooth);
  }

  .badge:hover {
    border-color: rgba(220, 68, 68, 0.4);
    background: rgba(220, 68, 68, 0.04);
    color: #ffffff;
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .footer-links-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .col-title {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .col-list a {
    font-size: 13.5px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: var(--transition-smooth);
    display: inline-block;
  }

  .col-list a:hover {
    color: #ffffff;
    transform: translateX(4px);
  }

  .disabled-link {
    opacity: 0.5;
    cursor: not-allowed !important;
  }

  .disabled-link:hover {
    transform: none !important;
    color: var(--text-secondary) !important;
  }

  .tag-soon {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    background: rgba(220, 68, 68, 0.1);
    color: rgb(240, 100, 100);
    padding: 1px 4px;
    border-radius: 3px;
    margin-left: 4px;
    border: 1px solid rgba(220, 68, 68, 0.2);
  }

  .footer-text {
    font-size: 13.5px;
    color: var(--text-secondary);
  }

  /* Bottom Area */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 30px;
    margin-top: 40px;
  }

  .footer-bottom-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  .copyright {
    font-size: 13px;
    color: var(--text-secondary);
  }

  /* System Status Monitored */
  .system-status {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(16, 185, 129, 0.04);
    border: 1px solid rgba(16, 185, 129, 0.15);
    padding: 6px 14px;
    border-radius: 100px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.8);
    animation: status-pulse 2s infinite alternate;
  }

  .status-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    color: #10b981;
    letter-spacing: 0.02em;
  }

  @keyframes status-pulse {
    0% { transform: scale(0.9); opacity: 0.6; }
    100% { transform: scale(1.15); opacity: 1; }
  }

  /* Responsive Design */
  @media (max-width: 992px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .brand-description {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .footer {
      padding: 60px 30px 30px 30px;
    }

    .footer-links-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .footer-bottom-container {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
