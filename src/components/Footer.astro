---
import Logo from './Logo.astro';
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-brand">
      <div class="footer-logo-row">
        <Logo variant="full" size="lg" href="/" showTagline={true} />
      </div>
      <p class="brand-description">
        <em>CodeCraft Perú</em> — reemplazo herramientas sueltas por una sola plataforma de gestión para empresas de servicios: propuestas, proyectos, timesheet, control documentario, logística y personal. Hablas directo con quien programa.
      </p>
    </div>

    <div class="footer-links-grid">
      <div class="footer-links-col">
        <h3 class="col-title">Módulos</h3>
        <ul class="col-list">
          <li><a href="#modulo-propuestas">Propuestas</a></li>
          <li><a href="#modulo-proyectos">Control de Proyectos</a></li>
          <li><a href="#modulo-timesheet">Timesheet</a></li>
          <li><a href="#modulo-documentario">Control Documentario</a></li>
          <li><a href="#modulo-logistica">Logística</a></li>
          <li><a href="#modulo-personal">Personal</a></li>
        </ul>
      </div>

      <div class="footer-links-col">
        <h3 class="col-title">Navegación</h3>
        <ul class="col-list">
          <li><a href="#hero">Inicio</a></li>
          <li><a href="#servicios">El sistema</a></li>
          <li><a href="#proceso">Proceso</a></li>
          <li><a href="#confianza">Confianza</a></li>
          <li><a href="#cotizar">Cotizar</a></li>
          <li><a href="/about">Quiénes somos</a></li>
        </ul>
      </div>

      <div class="footer-links-col">
        <h3 class="col-title">Contacto</h3>
        <ul class="col-list">
          <li><a href="mailto:steepbsm@gmail.com">steepbsm@gmail.com</a></li>
          <li><a href="https://github.com/steepsalvadorman" target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><span class="footer-text">Lima, Perú 🇵🇪</span></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-container">
      <p class="copyright">
        &copy; {new Date().getFullYear()} CodeCraft Perú. Todos los derechos reservados.
      </p>
      <div class="system-status">
        <span class="status-dot"></span>
        <span class="status-text">DISPONIBLE PARA PROYECTOS</span>
      </div>
    </div>
  </div>
</footer>
