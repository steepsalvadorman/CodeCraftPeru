---
import CodeCraftIcon from './icons/CodeCraftIcon.astro';

interface Props {
  variant?: 'full' | 'icon' | 'text';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  animated?: boolean;
  showTagline?: boolean;
}

const {
  variant = 'full',
  size = 'md',
  href = '/',
  animated = true,
  showTagline = false,
} = Astro.props;

const sizeMap = { sm: 24, md: 28, lg: 36 };
const iconSize = sizeMap[size];
const iconId = `logo-${size}`;
---

{variant === 'full' ? (
  <a
    href={href}
    class:list={['logo-full', `logo-full--${size}`, { 'logo-full--animated': animated }]}
    aria-label="CodeCraft Perú — Inicio"
  >
    <CodeCraftIcon id={iconId} class="logo-svg" width={iconSize} height={iconSize} />
    <span class="logo-lockup">
      <span class="logo-wordmark">
        <span class="logo-code">&lt;</span><span class="logo-name">CodeCraft</span><span class="logo-country">Perú</span><span class="logo-code">&gt;</span>
      </span>
      {showTagline && (
        <span class="logo-badge-status">Sistemas de gestión web</span>
      )}
    </span>
  </a>
) : variant === 'icon' ? (
  <a
    href={href}
    class:list={['logo-icon-only', `logo-icon-only--${size}`, { 'logo-icon-only--animated': animated }]}
    aria-label="CodeCraft Perú — Inicio"
  >
    <CodeCraftIcon id={iconId} class="logo-svg" width={iconSize} height={iconSize} />
  </a>
) : (
  <a href={href} class:list={['logo-text-only', `logo-text-only--${size}`]}>
    <span class="logo-lockup">
      <span class="logo-wordmark">
        <span class="logo-code">&lt;</span><span class="logo-name">CodeCraft</span><span class="logo-country">Perú</span><span class="logo-code">&gt;</span>
      </span>
      {showTagline && <span class="logo-badge-status">Sistemas de gestión web</span>}
    </span>
  </a>
)}
