---
interface Props {
  variant?: 'full' | 'icon' | 'text';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  animated?: boolean;
  showTagline?: boolean;
}

const {
  variant = 'full',
  size = 'md',
  href = '/',
  animated = true,
  showTagline = true,
} = Astro.props;

const sizeMap = { sm: 28, md: 36, lg: 44 };
const iconSize = sizeMap[size];
---

{variant === 'full' ? (
  <a href={href} class:list={['logo-full', `logo-full--${size}`, { 'logo-full--animated': animated }]} aria-label="SteepDev — Inicio">
    <svg
      class="logo-svg"
      width={iconSize}
      height={iconSize}
      viewBox="0 0 128 128"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="logo-grad-green" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#00ff88" />
          <stop offset="100%" stop-color="#00cc6a" />
        </linearGradient>
        <linearGradient id="logo-grad-dark" x1="50%" y1="0%" x2="50%" y2="100%">
          <stop offset="0%" stop-color="#12141c" />
          <stop offset="100%" stop-color="#0a0a0f" />
        </linearGradient>
      </defs>
      <!-- Terminal window frame -->
      <rect x="8" y="20" width="112" height="88" rx="10" stroke="url(#logo-grad-green)" stroke-width="3" fill="url(#logo-grad-dark)" />
      <!-- Title bar -->
      <line x1="8" y1="38" x2="120" y2="38" stroke="url(#logo-grad-green)" stroke-width="2" opacity="0.4" />
      <!-- Traffic lights -->
      <circle cx="22" cy="29" r="3.5" fill="#ff5f57" />
      <circle cx="34" cy="29" r="3.5" fill="#febc2e" />
      <circle cx="46" cy="29" r="3.5" fill="#28c840" />
      <!-- Code brackets < /> -->
      <path d="M48,58 L34,72 L48,86" stroke="url(#logo-grad-green)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <path d="M80,58 L94,72 L80,86" stroke="url(#logo-grad-green)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <line x1="58" y1="88" x2="70" y2="56" stroke="#00ff88" stroke-width="4" stroke-linecap="round" opacity="0.7" />
      <!-- Cursor blink -->
      <rect x="58" y="78" width="10" height="3" fill="#00ff88" opacity="0.8">
        <animate attributeName="opacity" values="0.8;0;0.8" dur="1.2s" repeatCount="indefinite" />
      </rect>
    </svg>
    <span class="logo-lockup">
      <span class="logo-wordmark">
        <span class="logo-name">steep</span><span class="logo-accent">.dev</span>
      </span>
      {showTagline && (
        <span class="logo-tagline">Freelance Developer</span>
      )}
    </span>
  </a>
) : variant === 'icon' ? (
  <a href={href} class:list={['logo-icon-only', `logo-icon-only--${size}`, { 'logo-icon-only--animated': animated }]} aria-label="SteepDev — Inicio">
    <svg class="logo-svg" width={iconSize} height={iconSize} viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect x="8" y="20" width="112" height="88" rx="10" stroke="#00ff88" stroke-width="3" fill="#0a0a0f" />
      <line x1="8" y1="38" x2="120" y2="38" stroke="#00ff88" stroke-width="2" opacity="0.4" />
      <circle cx="22" cy="29" r="3.5" fill="#ff5f57" />
      <circle cx="34" cy="29" r="3.5" fill="#febc2e" />
      <circle cx="46" cy="29" r="3.5" fill="#28c840" />
      <path d="M48,58 L34,72 L48,86" stroke="#00ff88" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <path d="M80,58 L94,72 L80,86" stroke="#00ff88" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <line x1="58" y1="88" x2="70" y2="56" stroke="#00ff88" stroke-width="4" stroke-linecap="round" opacity="0.7" />
    </svg>
  </a>
) : (
  <a href={href} class:list={['logo-text-only', `logo-text-only--${size}`]}>
    <span class="logo-lockup">
      <span class="logo-wordmark">
        <span class="logo-name">steep</span><span class="logo-accent">.dev</span>
      </span>
      {showTagline && <span class="logo-tagline">Freelance Developer</span>}
    </span>
  </a>
)}
