---
---

<section id="hero" class="hero-section">
  <div class="hero-grid">
    <div class="hero-left animate-fade-in">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        <span class="badge-text">Disponible para proyectos</span>
      </div>

      <h1 class="hero-title">
        Hola, soy <span class="accent-text">Steep</span>.<br />
        Construyo <span class="hero-title-accent">sistemas de gestión</span> que hacen crecer empresas.
      </h1>

      <p class="hero-subtitle">
        Desarrollador frontend freelance especializado en ERP, inventarios, CRM y dashboards web.
        Transformo procesos manuales en plataformas digitales que ahorran tiempo y reducen errores.
      </p>

      <div class="hero-ctas">
        <a href="#cotizar" class="btn btn--accent">
          <span>Cotizar mi Proyecto</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a href="#servicios" class="btn btn--ghost">
          Ver Servicios
        </a>
      </div>

      <div class="hero-metrics" aria-label="Indicadores clave">
        <div class="hero-metric">
          <span class="hero-metric__value">100%</span>
          <span class="hero-metric__label">Código propio</span>
        </div>
        <span class="hero-metric__sep" aria-hidden="true"></span>
        <div class="hero-metric">
          <span class="hero-metric__value">48h</span>
          <span class="hero-metric__label">Respuesta cotización</span>
        </div>
        <span class="hero-metric__sep" aria-hidden="true"></span>
        <div class="hero-metric">
          <span class="hero-metric__value">Directo</span>
          <span class="hero-metric__label">Trato directo</span>
        </div>
      </div>
    </div>

    <div class="hero-right animate-fade-in" style="animation-delay: 0.15s;">
      <div class="terminal-window">
        <div class="terminal-titlebar">
          <div class="terminal-dots">
            <span class="dot dot--red"></span>
            <span class="dot dot--yellow"></span>
            <span class="dot dot--green"></span>
          </div>
          <span class="terminal-filename">steep@dev: ~/perfil</span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-command">whoami</span>
          </div>
          <div class="terminal-output">
            <span class="terminal-key">nombre</span>: <span class="terminal-string">"Steep"</span><br />
            <span class="terminal-key">rol</span>: <span class="terminal-string">"Frontend Developer Freelance"</span><br />
            <span class="terminal-key">ubicacion</span>: <span class="terminal-string">"Lima, Perú 🇵🇪"</span><br />
            <span class="terminal-key">especialidad</span>: <span class="terminal-string">"Sistemas de Gestión Web"</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-command">cat stack.txt</span>
          </div>
          <div class="terminal-output">
            <span class="terminal-tag">[frontend]</span> Astro · React · TypeScript · Tailwind<br />
            <span class="terminal-tag">[backend]</span>&nbsp; Node.js · APIs REST · PostgreSQL<br />
            <span class="terminal-tag">[deploy]</span>&nbsp;&nbsp; Vercel · Netlify · VPS · Docker
          </div>
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-command">./cotizar --empresa "tu-empresa"</span>
            <span class="terminal-cursor"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
