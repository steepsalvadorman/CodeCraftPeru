---
---

<section id="paas-suite" class="paas-suite-section">
  <div class="section-header">
    <h2 class="section-title gradient-text">Nuestra Suite de Soluciones PaaS</h2>
    <p class="section-subtitle">
      Plataformas Cloud nativas diseñadas específicamente para resolver ineficiencias, reducir costos y automatizar operaciones críticas en plantas concentradoras y minas subterráneas.
    </p>
  </div>

  <div class="paas-grid">
    <!-- WeighFlow Card -->
    <div class="paas-card glass-panel" style="--card-glow-color: var(--color-weighflow);" data-product="weighflow">
      <div class="card-glow-layer"></div>
      <div class="card-header">
        <div class="card-icon-container" style="--icon-color: var(--color-weighflow); --icon-bg: rgba(16, 185, 129, 0.08);">
          <svg xmlns="http://www.w3.org/2000/svg" class="card-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
          </svg>
        </div>
        <span class="tech-badge" style="--badge-glow: rgba(16, 185, 129, 0.15); --badge-text-color: var(--color-weighflow);">RUST + TCP/IP</span>
      </div>
      
      <h3 class="card-title">WeighFlow IoT</h3>
      <p class="card-description">
        Sincronización en tiempo real y telemetría de balanzas industriales TI420. Extrae datos del pesaje físico con encriptación STX/CKS, previniendo fraudes y asegurando trazabilidad de carga.
      </p>
      
      <div class="card-footer">
        <a href="#detalles-weighflow" class="card-link" style="--link-color: var(--color-weighflow);">
          <span>Explorar Arquitectura</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="arrow-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- VentiFlow Card -->
    <div class="paas-card glass-panel" style="--card-glow-color: var(--color-ventiflow);" data-product="ventiflow">
      <div class="card-glow-layer"></div>
      <div class="card-header">
        <div class="card-icon-container" style="--icon-color: var(--color-ventiflow); --icon-bg: rgba(6, 182, 212, 0.08);">
          <svg xmlns="http://www.w3.org/2000/svg" class="card-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-11.314l.707.707m12.728 12.728l.707-.707M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <span class="tech-badge" style="--badge-glow: rgba(6, 182, 212, 0.15); --badge-text-color: var(--color-ventiflow);">SPRING AI + TELEMETRÍA</span>
      </div>
      
      <h3 class="card-title">VentiFlow IoT</h3>
      <p class="card-description">
        Optimización de ventilación y monitoreo de gases ($CO, NO_2, O_2$) en galerías subterráneas. Automatiza el ciclo de ventiladores de forma inteligente, reduciendo el consumo eléctrico hasta en un 40%.
      </p>
      
      <div class="card-footer">
        <a href="#detalles-ventiflow" class="card-link" style="--link-color: var(--color-ventiflow);">
          <span>Explorar Arquitectura</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="arrow-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- LoadGrade Card -->
    <div class="paas-card glass-panel" style="--card-glow-color: var(--color-loadgrade);" data-product="loadgrade">
      <div class="card-glow-layer"></div>
      <div class="card-header">
        <div class="card-icon-container" style="--icon-color: var(--color-loadgrade); --icon-bg: rgba(249, 115, 22, 0.08);">
          <svg xmlns="http://www.w3.org/2000/svg" class="card-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
        </div>
        <span class="tech-badge" style="--badge-glow: rgba(249, 115, 22, 0.15); --badge-text-color: var(--color-loadgrade);">KOTLIN + GEO-FENCING</span>
      </div>
      
      <h3 class="card-title">LoadGrade PaaS</h3>
      <p class="card-description">
        Despacho móvil y control de ley de mineral en ruta. Utiliza coordenadas en tiempo real y geo-cercas de alta definición para impedir descargas erróneas en botaderos o chancadoras primarias.
      </p>
      
      <div class="card-footer">
        <a href="#detalles-loadgrade" class="card-link" style="--link-color: var(--color-loadgrade);">
          <span>Explorar Arquitectura</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="arrow-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- TireTrack Card -->
    <div class="paas-card glass-panel" style="--card-glow-color: var(--color-tiretrack);" data-product="tiretrack">
      <div class="card-glow-layer"></div>
      <div class="card-header">
        <div class="card-icon-container" style="--icon-color: var(--color-tiretrack); --icon-bg: rgba(239, 68, 68, 0.08);">
          <svg xmlns="http://www.w3.org/2000/svg" class="card-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <span class="tech-badge" style="--badge-glow: rgba(239, 68, 68, 0.15); --badge-text-color: var(--color-tiretrack);">RUST + TIMESCALEDB</span>
      </div>
      
      <h3 class="card-title">TireTrack IoT</h3>
      <p class="card-description">
        Gestión térmica y mantenimiento predictivo para neumáticos gigantes OTR. Procesa telemetría inalámbrica continua TPMS en el chasis del volquete, previniendo explosiones y optimizando la vida útil.
      </p>
      
      <div class="card-footer">
        <a href="#detalles-tiretrack" class="card-link" style="--link-color: var(--color-tiretrack);">
          <span>Explorar Arquitectura</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="arrow-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .paas-suite-section {
    padding: 80px 0;
    position: relative;
    z-index: 10;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 60px auto;
  }

  .section-title {
    font-size: 38px;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
    color: #ffffff;
  }

  .section-subtitle {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .paas-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  /* Estilos de la tarjeta interactiva */
  .paas-card {
    position: relative;
    padding: 36px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 380px;
  }

  .card-glow-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 0% 0%, var(--card-glow-color) 0%, transparent 40%);
    opacity: 0.05;
    transition: var(--transition-smooth);
    pointer-events: none;
    z-index: 0;
  }

  .paas-card:hover .card-glow-layer {
    opacity: 0.15;
  }

  .paas-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(var(--card-glow-color), 0.1);
    border-color: var(--card-glow-color);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
  }

  .card-icon-container {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--icon-bg);
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--icon-color);
    transition: var(--transition-smooth);
  }

  .paas-card:hover .card-icon-container {
    border-color: var(--icon-color);
    box-shadow: 0 0 15px var(--icon-bg);
  }

  .card-icon {
    width: 24px;
    height: 24px;
  }

  .tech-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    color: var(--badge-text-color);
    box-shadow: 0 0 10px var(--badge-glow);
  }

  .card-title {
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 14px;
    position: relative;
    z-index: 1;
  }

  .card-description {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 30px;
    flex-grow: 1;
    position: relative;
    z-index: 1;
  }

  .card-footer {
    position: relative;
    z-index: 1;
    margin-top: auto;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: var(--transition-fast);
  }

  .arrow-icon {
    width: 14px;
    height: 14px;
    color: var(--link-color);
    transition: transform 0.3s ease;
  }

  .card-link:hover {
    color: var(--link-color);
  }

  .card-link:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* Responsive */
  @media (max-width: 992px) {
    .paas-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 576px) {
    .paas-card {
      padding: 24px;
      min-height: auto;
    }
    .section-title {
      font-size: 28px;
    }
  }
</style>
