---
import '../styles/navbar.css'; // Importa el CSS de la navbar
---

<header class="header">
  <div class="logo-area">
    <!-- Isotipo Tecnológico SVG Embebido -->
    <svg class="logo-icon" viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="navNeonRed" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#ff6b6b" />
          <stop offset="100%" stop-color="#b91c1c" />
        </linearGradient>
      </defs>
      <polygon points="64,10 116,40 116,96 64,126 12,96 12,40" stroke="url(#navNeonRed)" stroke-width="8" fill="#07090e" stroke-linejoin="round" />
      <path d="M46,44 L28,64 L46,84" stroke="#ff6b6b" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <path d="M82,44 L100,64 L82,84" stroke="#ff6b6b" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <circle cx="64" cy="64" r="14" stroke="#10b981" stroke-width="6" fill="none" />
      <circle cx="64" cy="64" r="6" fill="#10b981" />
    </svg>
    
    <a href="#" class="logo">
      <span class="logo-code">&lt;</span>CodeCraft<span class="logo-country">Perú</span><span class="logo-code">&gt;</span>
    </a>
    <span class="logo-badge-status">ENGINE ACTIVE</span>
  </div>

  <nav class="navbar" id="navbar">
    <div class="nav-links">
      <a href="#"><span class="nav-num">01.</span>/inicio</a>
      <a href="#paas-suite"><span class="nav-num">02.</span>/soluciones-paas</a>
      <a href="#detalles-tecnicos"><span class="nav-num">03.</span>/detalles-tecnicos</a>
      <a href="#contacto"><span class="nav-num">04.</span>/contacto</a>
    </div>
    <a href="#contacto" class="nav-cta">
      <span>Solicitar Factibilidad</span>
    </a>
  </nav>

  <div class="hamburger" id="hamburger" aria-label="Abrir Menú">
    <div class="bar bar1"></div>
    <div class="bar bar2"></div>
    <div class="bar bar3"></div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const hamburger = document.getElementById('hamburger');
    const navbar = document.getElementById('navbar');

    if (hamburger && navbar) {
      hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        navbar.classList.toggle('active');
      });

      // Cerrar el menú móvil al hacer clic en un enlace
      const links = navbar.querySelectorAll('a');
      links.forEach(link => {
        link.addEventListener('click', () => {
          hamburger.classList.remove('active');
          navbar.classList.remove('active');
        });
      });
    }
  });
</script>
