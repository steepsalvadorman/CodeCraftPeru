---
import Logo from './Logo.astro';

const navItems = [
  { href: '#hero', label: 'Inicio', section: 'hero' },
  { href: '#servicios', label: 'Servicios', section: 'servicios' },
  { href: '#proceso', label: 'Proceso', section: 'proceso' },
  { href: '#cotizar', label: 'Cotizar', section: 'cotizar' },
];
---

<header class="header" id="site-header">
  <div class="header-inner">
    <Logo variant="full" size="md" href="/" showTagline={false} animated={false} />

    <nav class="navbar" id="navbar" aria-label="Navegación principal">
      <ul class="nav-links" id="nav-links">
        {navItems.map((item) => (
          <li class="nav-item">
            <a
              href={item.href}
              class="nav-link"
              data-section={item.section}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <a href="#cotizar" class="nav-cta">
        Cotizar Proyecto
      </a>
    </nav>

    <button class="hamburger" id="hamburger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="navbar">
      <span class="bar bar1"></span>
      <span class="bar bar2"></span>
      <span class="bar bar3"></span>
    </button>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const hamburger = document.getElementById('hamburger');
  const navbar = document.getElementById('navbar');
  const navLinks = navbar?.querySelectorAll<HTMLAnchorElement>('.nav-link');

  let ticking = false;
  let isNavigating = false;
  let activeSectionId = '';
  let navigateTimer: ReturnType<typeof setTimeout> | undefined;

  const sections = ['hero', 'servicios', 'proceso', 'cotizar']
    .map((id) => document.getElementById(id))
    .filter(Boolean) as HTMLElement[];

  function getHeaderOffset() {
    return (header?.offsetHeight ?? 72) + 16;
  }

  function getActiveSectionId(): string {
    const marker = window.scrollY + getHeaderOffset() + 48;
    let activeId = sections[0]?.id ?? 'hero';

    for (const section of sections) {
      if (section.offsetTop <= marker) {
        activeId = section.id;
      }
    }

    return activeId;
  }

  function updateActiveSectionFromScroll() {
    if (isNavigating || !sections.length) return;
    setActiveLink(getActiveSectionId());
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        header?.classList.toggle('header--scrolled', window.scrollY > 24);
        updateActiveSectionFromScroll();
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

  function setActiveLink(sectionId: string) {
    if (sectionId === activeSectionId) return;
    activeSectionId = sectionId;

    navLinks?.forEach((link) => {
      const isActive = link.dataset.section === sectionId;
      link.classList.toggle('is-active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  function scrollToSection(sectionId: string) {
    const target = document.getElementById(sectionId);
    if (!target) return;

    isNavigating = true;
    clearTimeout(navigateTimer);
    setActiveLink(sectionId);

    const top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - getHeaderOffset());
    window.scrollTo({ top, behavior: 'smooth' });
    history.replaceState(null, '', `#${sectionId}`);

    const finishNavigation = () => {
      isNavigating = false;
      setActiveLink(sectionId);
    };

    if ('onscrollend' in window) {
      window.addEventListener('scrollend', finishNavigation, { once: true });
    } else {
      navigateTimer = setTimeout(finishNavigation, 750);
    }
  }

  if (sections.length && navLinks?.length) {
    updateActiveSectionFromScroll();

    const initialHash = window.location.hash.slice(1);
    if (initialHash && document.getElementById(initialHash)) {
      requestAnimationFrame(() => scrollToSection(initialHash));
    }
  }

  navbar?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (!href || href === '#') return;
      e.preventDefault();
      const sectionId = link.dataset.section ?? href.slice(1);
      scrollToSection(sectionId);

      hamburger?.classList.remove('active');
      navbar?.classList.remove('active');
      document.body.classList.remove('nav-open');
      hamburger?.setAttribute('aria-expanded', 'false');
      hamburger?.setAttribute('aria-label', 'Abrir menú');
    });
  });

  if (hamburger && navbar) {
    hamburger.addEventListener('click', () => {
      const isOpen = hamburger.classList.toggle('active');
      navbar.classList.toggle('active');
      document.body.classList.toggle('nav-open', isOpen);
      hamburger.setAttribute('aria-expanded', String(isOpen));
      hamburger.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
    });
  }
</script>
