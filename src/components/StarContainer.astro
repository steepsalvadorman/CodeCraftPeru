---
---

<div id="star-container" aria-hidden="true">
  <div class="cosmos-nebula cosmos-nebula--1"></div>
  <div class="cosmos-nebula cosmos-nebula--2"></div>
  <div class="cosmos-nebula cosmos-nebula--3"></div>
  <div class="cosmos-dust"></div>
  <canvas id="star-canvas"></canvas>
  <div class="cosmos-vignette"></div>
</div>

<script>
  type StarLayer = 'far' | 'mid' | 'near';

  interface Star {
    x: number;
    y: number;
    radius: number;
    phase: number;
    speed: number;
    baseOpacity: number;
    layer: StarLayer;
    r: number;
    g: number;
    b: number;
    glow: boolean;
  }

  interface Comet {
    x: number;
    y: number;
    vx: number;
    vy: number;
    life: number;
    maxLife: number;
  }

  const container = document.getElementById('star-container');
  const canvas = document.getElementById('star-canvas') as HTMLCanvasElement | null;

  if (container && canvas) {
    const ctx = canvas.getContext('2d', { alpha: true, desynchronized: true });
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TARGET_FPS = 60;
    const FRAME_BUDGET = 1000 / TARGET_FPS;

    const LAYER_CONFIG: Record<StarLayer, { count: number; rMin: number; rMax: number; speed: number }> = {
      far:  { count: reducedMotion ? 60 : 110, rMin: 0.3, rMax: 0.9,  speed: 0.2 },
      mid:  { count: reducedMotion ? 25 : 45,  rMin: 0.7, rMax: 1.4, speed: 0.45 },
      near: { count: reducedMotion ? 8  : 18,   rMin: 1.2, rMax: 2.2, speed: 0.7 },
    };

    const PALETTE = [
      [255, 255, 255],
      [220, 230, 255],
      [200, 210, 255],
      [255, 240, 230],
      [239, 68, 68],
    ] as const;

    let stars: Star[] = [];
    let comets: Comet[] = [];
    let rafId = 0;
    let lastFrame = 0;
    let width = 0;
    let height = 0;
    let dpr = 1;
    let isVisible = !document.hidden;
    let cometTimer = 0;

    function pickColor(): (typeof PALETTE)[number] {
      const roll = Math.random();
      if (roll < 0.62) return PALETTE[0];
      if (roll < 0.82) return PALETTE[1];
      if (roll < 0.93) return PALETTE[2];
      if (roll < 0.98) return PALETTE[3];
      return PALETTE[4];
    }

    function createLayer(layer: StarLayer): Star[] {
      const cfg = LAYER_CONFIG[layer];
      return Array.from({ length: cfg.count }, () => {
        const [r, g, b] = pickColor();
        return {
          x: Math.random(),
          y: Math.random(),
          radius: cfg.rMin + Math.random() * (cfg.rMax - cfg.rMin),
          phase: Math.random() * Math.PI * 2,
          speed: cfg.speed * (0.5 + Math.random()),
          baseOpacity: layer === 'far' ? 0.25 + Math.random() * 0.35 : 0.4 + Math.random() * 0.45,
          layer,
          r, g, b,
          glow: layer === 'near' && Math.random() > 0.55,
        };
      });
    }

    function createStars(): Star[] {
      return [
        ...createLayer('far'),
        ...createLayer('mid'),
        ...createLayer('near'),
      ];
    }

    function spawnComet() {
      if (reducedMotion) return;
      const fromTop = Math.random() > 0.5;
      comets.push({
        x: Math.random() * width,
        y: fromTop ? -20 : Math.random() * height * 0.4,
        vx: 280 + Math.random() * 180,
        vy: 120 + Math.random() * 80,
        life: 0,
        maxLife: 0.6 + Math.random() * 0.5,
      });
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas!.width = Math.floor(width * dpr);
      canvas!.height = Math.floor(height * dpr);
      canvas!.style.width = `${width}px`;
      canvas!.style.height = `${height}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function drawStar(star: Star, dt: number) {
      star.phase += star.speed * dt;
      const twinkle = 0.5 + 0.5 * Math.sin(star.phase);
      const alpha = star.baseOpacity * (0.55 + 0.45 * twinkle);
      const px = star.x * width;
      const py = star.y * height;

      if (star.glow && star.radius > 1) {
        const grd = ctx!.createRadialGradient(px, py, 0, px, py, star.radius * 4);
        grd.addColorStop(0, `rgba(${star.r},${star.g},${star.b},${(alpha * 0.35).toFixed(3)})`);
        grd.addColorStop(1, 'rgba(0,0,0,0)');
        ctx!.fillStyle = grd;
        ctx!.fillRect(px - star.radius * 4, py - star.radius * 4, star.radius * 8, star.radius * 8);
      }

      ctx!.beginPath();
      ctx!.arc(px, py, star.radius, 0, Math.PI * 2);
      ctx!.fillStyle = `rgba(${star.r},${star.g},${star.b},${alpha.toFixed(3)})`;
      ctx!.fill();
    }

    function drawComets(dt: number) {
      cometTimer += dt;
      if (cometTimer > 4 + Math.random() * 6 && comets.length < 2) {
        spawnComet();
        cometTimer = 0;
      }

      comets = comets.filter((c) => {
        c.life += dt;
        c.x += c.vx * dt;
        c.y += c.vy * dt;
        const progress = c.life / c.maxLife;
        if (progress >= 1) return false;

        const fade = 1 - progress;
        const tailLen = 80 * fade;
        const grad = ctx!.createLinearGradient(c.x, c.y, c.x - tailLen * 0.7, c.y - tailLen * 0.4);
        grad.addColorStop(0, `rgba(255,255,255,${(0.9 * fade).toFixed(3)})`);
        grad.addColorStop(0.4, `rgba(180,210,255,${(0.35 * fade).toFixed(3)})`);
        grad.addColorStop(1, 'rgba(255,255,255,0)');

        ctx!.strokeStyle = grad;
        ctx!.lineWidth = 1.5 * fade;
        ctx!.lineCap = 'round';
        ctx!.beginPath();
        ctx!.moveTo(c.x, c.y);
        ctx!.lineTo(c.x - tailLen * 0.7, c.y - tailLen * 0.4);
        ctx!.stroke();
        return true;
      });
    }

    function drawFrame(timestamp: number) {
      if (!isVisible) {
        rafId = requestAnimationFrame(drawFrame);
        return;
      }

      const elapsed = timestamp - lastFrame;
      if (elapsed < FRAME_BUDGET) {
        rafId = requestAnimationFrame(drawFrame);
        return;
      }
      lastFrame = timestamp - (elapsed % FRAME_BUDGET);
      const dt = elapsed / 1000;

      ctx!.clearRect(0, 0, width, height);

      for (let i = 0; i < stars.length; i++) {
        drawStar(stars[i], dt);
      }

      drawComets(dt);

      rafId = requestAnimationFrame(drawFrame);
    }

    function start() {
      cancelAnimationFrame(rafId);
      lastFrame = performance.now();
      rafId = requestAnimationFrame(drawFrame);
    }

    stars = createStars();
    resize();
    start();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 100);
    }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible) start();
    });
  }
</script>
