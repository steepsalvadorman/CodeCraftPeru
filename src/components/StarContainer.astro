---
---

<div id="star-container" aria-hidden="true">
  <div class="cosmos-aurora"></div>
  <div class="cosmos-gold-ray"></div>
  <div class="cosmos-nebula cosmos-nebula--1"></div>
  <div class="cosmos-nebula cosmos-nebula--2"></div>
  <div class="cosmos-nebula cosmos-nebula--3"></div>
  <div class="cosmos-dust"></div>
  <canvas id="star-canvas"></canvas>
  <div class="cosmos-vignette"></div>
</div>

<script>
  type StarLayer = 'far' | 'mid' | 'near';

  interface Star {
    px: number;
    py: number;
    radius: number;
    phase: number;
    speed: number;
    baseOpacity: number;
    layer: StarLayer;
    r: number;
    g: number;
    b: number;
    glow: boolean;
  }

  interface Comet {
    x: number;
    y: number;
    vx: number;
    vy: number;
    life: number;
    maxLife: number;
  }

  const container = document.getElementById('star-container');
  const canvas = document.getElementById('star-canvas') as HTMLCanvasElement | null;

  if (container && canvas) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    const ctx = canvas.getContext('2d', { alpha: true, desynchronized: true });

    const TARGET_FPS = 60;
    const FIXED_DT = 1 / TARGET_FPS;
    const MAX_DT = FIXED_DT * 3;

    const LAYER_CONFIG: Record<StarLayer, { count: number; rMin: number; rMax: number; speed: number }> = {
      far: {
        count: reducedMotion ? 40 : isMobile ? 70 : 100,
        rMin: 0.3,
        rMax: 0.9,
        speed: 0.2,
      },
      mid: {
        count: reducedMotion ? 18 : isMobile ? 32 : 40,
        rMin: 0.7,
        rMax: 1.4,
        speed: 0.45,
      },
      near: {
        count: reducedMotion ? 6 : isMobile ? 10 : 14,
        rMin: 1.2,
        rMax: 2.0,
        speed: 0.7,
      },
    };

    const PALETTE = [
      [250, 246, 235],
      [245, 230, 163],
      [240, 215, 140],
      [212, 175, 55],
      [138, 115, 68],
    ] as const;

    let stars: Star[] = [];
    let comets: Comet[] = [];
    let rafId = 0;
    let lastFrame = 0;
    let width = 0;
    let height = 0;
    let dpr = 1;
    let isVisible = !document.hidden;
    let cometTimer = 0;
    let farFrame = 0;
    let farLayerCanvas: OffscreenCanvas | HTMLCanvasElement | null = null;
    let farLayerCtx: CanvasRenderingContext2D | OffscreenCanvasRenderingContext2D | null = null;

    function pickColor(): (typeof PALETTE)[number] {
      const roll = Math.random();
      if (roll < 0.55) return PALETTE[0];
      if (roll < 0.75) return PALETTE[1];
      if (roll < 0.88) return PALETTE[2];
      if (roll < 0.96) return PALETTE[3];
      return PALETTE[4];
    }

    function createLayer(layer: StarLayer): Star[] {
      const cfg = LAYER_CONFIG[layer];
      return Array.from({ length: cfg.count }, () => {
        const [r, g, b] = pickColor();
        return {
          px: 0,
          py: 0,
          radius: cfg.rMin + Math.random() * (cfg.rMax - cfg.rMin),
          phase: Math.random() * Math.PI * 2,
          speed: cfg.speed * (0.5 + Math.random()),
          baseOpacity: layer === 'far' ? 0.25 + Math.random() * 0.35 : 0.4 + Math.random() * 0.45,
          layer,
          r,
          g,
          b,
          glow: layer === 'near' && Math.random() > 0.6,
        };
      });
    }

    function createStars(): Star[] {
      return [...createLayer('far'), ...createLayer('mid'), ...createLayer('near')];
    }

    function initStarPositions() {
      for (let i = 0; i < stars.length; i++) {
        stars[i].px = Math.random() * width;
        stars[i].py = Math.random() * height;
      }
    }

    function ensureFarLayer() {
      if (typeof OffscreenCanvas === 'undefined') {
        farLayerCanvas = null;
        farLayerCtx = null;
        return;
      }
      farLayerCanvas = new OffscreenCanvas(Math.floor(width * dpr), Math.floor(height * dpr));
      farLayerCtx = farLayerCanvas.getContext('2d');
      if (farLayerCtx) {
        farLayerCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
    }

    function spawnComet() {
      if (reducedMotion) return;
      const fromTop = Math.random() > 0.5;
      comets.push({
        x: Math.random() * width,
        y: fromTop ? -20 : Math.random() * height * 0.4,
        vx: 280 + Math.random() * 180,
        vy: 120 + Math.random() * 80,
        life: 0,
        maxLife: 0.6 + Math.random() * 0.5,
      });
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas!.width = Math.floor(width * dpr);
      canvas!.height = Math.floor(height * dpr);
      canvas!.style.width = `${width}px`;
      canvas!.style.height = `${height}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      initStarPositions();
      ensureFarLayer();
      farFrame = 0;
    }

    function starAlpha(star: Star): number {
      const twinkle = 0.5 + 0.5 * Math.sin(star.phase);
      return star.baseOpacity * (0.55 + 0.45 * twinkle);
    }

    type DrawCtx = CanvasRenderingContext2D | OffscreenCanvasRenderingContext2D;

    function drawDot(target: DrawCtx, star: Star, alpha: number, scale = 1) {
      target.globalAlpha = alpha;
      target.fillStyle = `rgb(${star.r},${star.g},${star.b})`;
      target.beginPath();
      target.arc(star.px, star.py, star.radius * scale, 0, Math.PI * 2);
      target.fill();
    }

    function renderFarLayer() {
      if (!farLayerCtx) return;

      farLayerCtx.clearRect(0, 0, width, height);
      for (let i = 0; i < stars.length; i++) {
        const star = stars[i];
        if (star.layer !== 'far') continue;
        drawDot(farLayerCtx, star, starAlpha(star) * 0.85, 1);
      }
    }

    function blitFarLayer() {
      if (farLayerCanvas) {
        ctx!.drawImage(farLayerCanvas as CanvasImageSource, 0, 0, width, height);
      }
    }

    function update(dt: number) {
      for (let i = 0; i < stars.length; i++) {
        stars[i].phase += stars[i].speed * dt;
      }

      cometTimer += dt;
      if (cometTimer > 5 + Math.random() * 5 && comets.length < 2) {
        spawnComet();
        cometTimer = 0;
      }

      comets = comets.filter((c) => {
        c.life += dt;
        c.x += c.vx * dt;
        c.y += c.vy * dt;
        return c.life / c.maxLife < 1;
      });
    }

    function renderMidNear() {
      for (let i = 0; i < stars.length; i++) {
        const star = stars[i];
        if (star.layer === 'far') continue;

        const alpha = starAlpha(star);
        if (star.glow) {
          drawDot(ctx!, star, alpha * 0.22, 3.2);
        }
        drawDot(ctx!, star, alpha, 1);
      }

      ctx!.globalAlpha = 1;
      ctx!.lineCap = 'round';

      for (let i = 0; i < comets.length; i++) {
        const c = comets[i];
        const progress = c.life / c.maxLife;
        const fade = 1 - progress;
        const tailLen = 80 * fade;

        ctx!.globalAlpha = 0.85 * fade;
        ctx!.strokeStyle = 'rgb(184,212,240)';
        ctx!.lineWidth = 1.5 * fade;
        ctx!.beginPath();
        ctx!.moveTo(c.x, c.y);
        ctx!.lineTo(c.x - tailLen * 0.7, c.y - tailLen * 0.4);
        ctx!.stroke();

        ctx!.globalAlpha = 0.35 * fade;
        ctx!.lineWidth = 3 * fade;
        ctx!.beginPath();
        ctx!.moveTo(c.x - tailLen * 0.15, c.y - tailLen * 0.08);
        ctx!.lineTo(c.x - tailLen * 0.7, c.y - tailLen * 0.4);
        ctx!.stroke();
      }

      ctx!.globalAlpha = 1;
    }

    function drawFrame(timestamp: number) {
      rafId = requestAnimationFrame(drawFrame);

      if (!isVisible || !ctx) return;

      if (!lastFrame) lastFrame = timestamp;
      const dt = Math.min((timestamp - lastFrame) / 1000, MAX_DT);
      lastFrame = timestamp;

      update(dt);

      ctx.clearRect(0, 0, width, height);

      farFrame += 1;
      const farLayerInterval = isMobile ? 4 : 3;
      if (farLayerCtx) {
        if (farFrame % farLayerInterval === 0) {
          renderFarLayer();
        }
        blitFarLayer();
      } else {
        for (let i = 0; i < stars.length; i++) {
          const star = stars[i];
          if (star.layer !== 'far') continue;
          drawDot(ctx!, star, starAlpha(star) * 0.85, 1);
        }
      }

      renderMidNear();
    }

    function start() {
      cancelAnimationFrame(rafId);
      lastFrame = 0;
      rafId = requestAnimationFrame(drawFrame);
    }

    stars = createStars();
    resize();
    start();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener(
      'resize',
      () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(resize, 120);
      },
      { passive: true }
    );

    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible) {
        lastFrame = 0;
        start();
      }
    });
  }
</script>
