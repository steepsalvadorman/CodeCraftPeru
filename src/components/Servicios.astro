---
const servicios = [
  {
    id: 'erp',
    icon: 'M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z',
    title: 'Sistema ERP Web',
    subtitle: 'Gestión empresarial integral',
    description: 'Plataforma web centralizada para finanzas, compras, ventas y operaciones. Un solo sistema para toda tu empresa.',
    features: ['Multi-usuario con roles', 'Reportes en tiempo real', 'Integración contable', 'API REST'],
    accent: '#00ff88',
    accentDim: 'rgba(0, 255, 136, 0.12)',
  },
  {
    id: 'inventarios',
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
    title: 'Control de Inventarios',
    subtitle: 'Stock y almacén inteligente',
    description: 'Kardex automático, trazabilidad multi-sede y alertas de stock mínimo. Controla tu mercadería desde cualquier lugar.',
    features: ['Multi-almacén', 'Lectura de códigos', 'Alertas automáticas', 'Historial completo'],
    accent: '#4da6ff',
    accentDim: 'rgba(77, 166, 255, 0.12)',
  },
  {
    id: 'crm',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
    title: 'CRM & Ventas',
    subtitle: 'Gestión comercial completa',
    description: 'Pipeline de ventas, seguimiento de clientes, cotizaciones y facturación electrónica integrada con SUNAT.',
    features: ['Pipeline visual', 'Cotizador integrado', 'Facturación SUNAT', 'Seguimiento automático'],
    accent: '#ffb800',
    accentDim: 'rgba(255, 184, 0, 0.12)',
  },
  {
    id: 'bi',
    icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
    title: 'Dashboards & BI',
    subtitle: 'Inteligencia de negocios',
    description: 'Tableros interactivos con KPIs, reportes programados y alertas. Toma decisiones basadas en datos reales.',
    features: ['KPIs personalizados', 'Reportes automáticos', 'Exportación PDF/Excel', 'Alertas inteligentes'],
    accent: '#ff6b6b',
    accentDim: 'rgba(255, 107, 107, 0.12)',
  },
];
---

<section id="servicios" class="servicios-section">
  <div class="section-header">
    <span class="section-label">// Servicios</span>
    <h2 class="section-title">Lo que puedo construir para tu empresa</h2>
    <p class="section-subtitle">
      Sistemas web a medida, diseñados para digitalizar y automatizar los procesos de tu negocio.
    </p>
  </div>

  <div class="servicios-grid">
    {servicios.map((s, i) => (
      <article class="servicio-card" style={`--card-accent: ${s.accent}; --card-accent-dim: ${s.accentDim}; animation-delay: ${i * 0.1}s;`}>
        <div class="servicio-card__top">
          <div class="servicio-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={s.icon} />
            </svg>
          </div>
          <span class="servicio-num">0{i + 1}</span>
        </div>

        <div class="servicio-card__body">
          <h3 class="servicio-title">{s.title}</h3>
          <p class="servicio-subtitle">{s.subtitle}</p>
          <p class="servicio-desc">{s.description}</p>
        </div>

        <ul class="servicio-features">
          {s.features.map((f) => (
            <li class="servicio-feature">
              <svg class="feature-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 13l4 4L19 7" />
              </svg>
              {f}
            </li>
          ))}
        </ul>

        <a href="#cotizar" class="servicio-cta">
          Cotizar este servicio
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </article>
    ))}
  </div>
</section>