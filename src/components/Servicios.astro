---
import { modulos } from '../data/modulos';

/**
 * The offer is one integrated platform for a professional-services firm, not a
 * catalogue. Modules are presented as parts of a single system, and each one
 * names what it receives and what it feeds, so the integration is visible in
 * the layout itself.
 *
 * The chain below is the margin story: a proposal priced from real staff rates
 * becomes a project budget, timesheets and logistics consume it, deliverables
 * mark real progress, and profitability falls out of the same data.
 */
const flujo = [
  { label: 'Propuesta', hint: 'Cotizas horas y perfiles' },
  { label: 'Proyecto', hint: 'Hereda el presupuesto' },
  { label: 'Timesheet', hint: 'El equipo carga horas' },
  { label: 'Costos', hint: 'Suma compras y subcontratos' },
  { label: 'Rentabilidad', hint: 'Margen real, al día' },
];

// Cards and the schema.org OfferCatalog read the same array.
// See src/data/modulos.ts
---

<section id="servicios" class="servicios-section">
  <div class="section-header">
    <span class="section-label">El sistema</span>
    <h2 class="section-title">Un sistema, <em>no seis programas sueltos</em></h2>
    <p class="section-subtitle">
      En una empresa de servicios el margen se pierde en silencio: las horas están en un Excel,
      las compras en otro, los entregables en una carpeta compartida. Recién al cerrar el proyecto
      te enteras de si ganaste o perdiste. Eso es lo que vengo a arreglar.
    </p>
  </div>

  <div class="integracion-flow" role="img" aria-label="Flujo de datos: la Propuesta abre el Proyecto, el Proyecto recibe las horas del Timesheet y los Costos de Logística, y todo converge en la Rentabilidad del proyecto.">
    <span class="integracion-flow__caption" aria-hidden="true">El dato se escribe una vez y viaja solo</span>
    <ol class="integracion-flow__track">
      {flujo.map((paso, i) => (
        <li class="flow-node" style={`animation-delay: ${i * 0.08}s;`}>
          <span class="flow-node__label">{paso.label}</span>
          <span class="flow-node__hint">{paso.hint}</span>
          {i < flujo.length - 1 && (
            <svg class="flow-node__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          )}
        </li>
      ))}
    </ol>
  </div>

  <div class="modulos-intro">
    <h3 class="modulos-intro__title">Los módulos que lo componen</h3>
    <p class="modulos-intro__text">
      Puedes arrancar por uno y sumar el resto después. Nacen conectados, así que no hay que integrarlos más tarde.
    </p>
  </div>

  <div class="servicios-grid">
    {modulos.map((m, i) => (
      <article id={`modulo-${m.id}`} class="servicio-card" style={`--card-accent: ${m.accent}; --card-accent-dim: ${m.accentDim}; animation-delay: ${i * 0.1}s;`}>
        <div class="servicio-card__top">
          <div class="servicio-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={m.icon} />
            </svg>
          </div>
          <span class="servicio-num">Módulo 0{i + 1}</span>
        </div>

        <div class="servicio-card__body">
          <h4 class="servicio-title">{m.title}</h4>
          <p class="servicio-subtitle">{m.subtitle}</p>
          <p class="servicio-desc">{m.description}</p>
        </div>

        <ul class="servicio-features">
          {m.outcomes.map((o) => (
            <li class="servicio-feature">
              <svg class="feature-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 13l4 4L19 7" />
              </svg>
              {o}
            </li>
          ))}
        </ul>

        <p class="servicio-conecta">
          <svg class="conecta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71" />
          </svg>
          {m.conecta}
        </p>

        <a href="#cotizar" class="servicio-cta" data-modulo={m.formValue}>
          Cotizar con este módulo
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </article>
    ))}
  </div>

  <p class="servicios-footnote">
    ¿No sabes por dónde empezar? En el diagnóstico revisamos tus procesos actuales y te digo
    qué módulo te devuelve más margen primero. <a href="#proceso">Así funciona el proceso</a>.
  </p>
</section>

<script>
  /** Carry the chosen module into the quote form so the user never repeats it. */
  document.querySelectorAll<HTMLAnchorElement>('.servicio-cta[data-modulo]').forEach((cta) => {
    cta.addEventListener('click', () => {
      const select = document.getElementById('serviceType') as HTMLSelectElement | null;
      const modulo = cta.dataset.modulo;
      if (!select || !modulo) return;

      const match = Array.from(select.options).some((opt) => opt.value === modulo);
      if (!match) return;

      select.value = modulo;
      select.dispatchEvent(new Event('change', { bubbles: true }));
    });
  });
</script>
