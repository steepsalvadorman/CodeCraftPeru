---
import Navbar from "../components/Navbar.astro";
import StarContainer from "../components/StarContainer.astro";
import Footer from "../components/Footer.astro";
import { modulos } from "../data/modulos";
import "../styles/global.css";
import "../styles/logo.css";
import "../styles/navbar.css";
import "../styles/hero.css";
import "../styles/servicios.css";

import "../styles/proceso.css";
import "../styles/confianza.css";
import "../styles/cotizar.css";
import "../styles/footer.css";
import "../styles/stars_background.css";
import "../styles/greek.css";

const BUSINESS_NAME = "CodeCraft Perú";
const CONTACT_EMAIL = "steepbsm@gmail.com";

interface Props {
	title?: string;
	description?: string;
	/** Social preview image, relative to the site root. Generated by src/pages/og-image.png.ts. */
	image?: string;
	/** Keeps a page out of the index — used by 404. */
	noindex?: boolean;
}

const {
	title = "CodeCraft Perú — ERP para empresas de servicios",
	description = "ERP a medida para empresas de servicios: propuestas, proyectos, timesheet, control documentario, logística y personal en una sola plataforma. Lima, Perú.",
	image = "/og-image.png",
	noindex = false,
} = Astro.props;

// Absolute URLs need `site` in astro.config.mjs (driven by SITE_URL). Until it
// is set, the tags that require one are omitted rather than emitted broken.
const site = Astro.site;
const canonicalURL = site ? new URL(Astro.url.pathname, site) : undefined;
const socialImageURL = site && image ? new URL(image, site) : undefined;

const businessId = site ? `${new URL("/", site).href}#business` : undefined;
const websiteId = site ? `${new URL("/", site).href}#website` : undefined;

// Built from the same array the cards render, so the catalog cannot drift from
// what the page actually offers.
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "ProfessionalService",
			...(businessId ? { "@id": businessId } : {}),
			name: BUSINESS_NAME,
			description:
				"Desarrollo de sistemas de gestión integrados para empresas de servicios: propuestas, control de proyectos, timesheet, control documentario, logística y personal.",
			...(site ? { url: new URL("/", site).href } : {}),
			email: CONTACT_EMAIL,
			inLanguage: "es-PE",
			address: {
				"@type": "PostalAddress",
				addressLocality: "Lima",
				addressCountry: "PE",
			},
			areaServed: { "@type": "Country", name: "Perú" },
			serviceType: "Desarrollo de software de gestión empresarial",
			hasOfferCatalog: {
				"@type": "OfferCatalog",
				name: "Módulos de la plataforma",
				itemListElement: modulos.map((m) => ({
					"@type": "Offer",
					itemOffered: {
						"@type": "Service",
						name: m.title,
						description: m.description,
					},
				})),
			},
		},
		{
			"@type": "WebSite",
			...(websiteId ? { "@id": websiteId } : {}),
			name: BUSINESS_NAME,
			...(site ? { url: new URL("/", site).href } : {}),
			inLanguage: "es-PE",
			...(businessId ? { publisher: { "@id": businessId } } : {}),
		},
		{
			"@type": "WebPage",
			...(canonicalURL ? { "@id": canonicalURL.href, url: canonicalURL.href } : {}),
			name: title,
			description,
			inLanguage: "es-PE",
			...(websiteId ? { isPartOf: { "@id": websiteId } } : {}),
		},
	],
};
---

<!DOCTYPE html>
<html lang="es-PE">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
	<meta name="theme-color" content="#050b16" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	{canonicalURL && <link rel="canonical" href={canonicalURL.href} />}

	<meta property="og:type" content="website" />
	<meta property="og:site_name" content={BUSINESS_NAME} />
	<meta property="og:locale" content="es_PE" />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	{canonicalURL && <meta property="og:url" content={canonicalURL.href} />}
	{socialImageURL && <meta property="og:image" content={socialImageURL.href} />}

	<meta name="twitter:card" content={socialImageURL ? "summary_large_image" : "summary"} />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	{socialImageURL && <meta name="twitter:image" content={socialImageURL.href} />}

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link
		href="https://fonts.googleapis.com/css2?family=GFS+Didot:ital@0;1&family=JetBrains+Mono:wght@500;700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;1,400&display=swap"
		rel="stylesheet"
	/>

	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
</head>
<body>
	<a href="#main" class="skip-link">Saltar al contenido</a>
	<Navbar />
	<StarContainer />
	<main class="main-content" id="main">
		<slot />
	</main>
	<Footer />
	<script>
		import '../scripts/anchor-scroll.ts';
	</script>
</body>
</html>
