---
import Navbar from "../components/Navbar.astro";
import StarContainer from "../components/StarContainer.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/logo.css";
import "../styles/navbar.css";
import "../styles/hero.css";
import "../styles/servicios.css";

import "../styles/proceso.css";
import "../styles/cotizar.css";
import "../styles/footer.css";
import "../styles/stars_background.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "SteepDev — Desarrollador Frontend Freelance | Sistemas de Gestión",
	description = "Desarrollo sistemas integrados de gestión web para empresas: ERP, inventarios, CRM y dashboards. Cotiza tu proyecto hoy.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="description" content={description} />
	<meta name="theme-color" content="#0a0a0f" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link
		href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
		rel="stylesheet"
	/>
	<title>{title}</title>
</head>
<body>
	<Navbar />
	<StarContainer />
	<main class="main-content">
		<slot />
	</main>
	<Footer />
	<script>
		import '../scripts/anchor-scroll.ts';
	</script>
</body>
</html>
