---
import Navbar from "../components/Navbar.astro";
import StarContainer from "../components/StarContainer.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
	title?: string;
}

const { title = "CodeCraft Perú | Ingeniería de Software e IoT Industrial" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<title>{title}</title>
</head>
<body>
	<Navbar />
	<StarContainer />
	<main class="main-content">
		<slot />
	</main>
	<Footer />
</body>
</html>

