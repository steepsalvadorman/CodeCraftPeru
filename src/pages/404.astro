---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Página no encontrada — CodeCraft Perú"
  description="La página que buscas no existe o cambió de dirección."
  noindex={true}
>
  <section class="hero-section animate-fade-in" style="max-width: 640px; margin: 0 auto; padding: 4rem 1.5rem;">
    <span class="section-label">Error 404</span>
    <h1 class="hero-title" style="font-size: clamp(1.75rem, 4vw, 2.5rem); margin-top: 1rem;">
      Esta página <em>no existe</em>
    </h1>
    <p class="hero-subtitle" style="margin-top: 1.25rem;">
      El enlace que seguiste está roto o la página cambió de dirección.
      Desde el inicio llegas a todo lo demás.
    </p>
    <div class="hero-ctas" style="margin-top: 2rem;">
      <a href="/" class="btn btn--accent">
        <span>Ir al inicio</span>
      </a>
      <a href="/#cotizar" class="btn btn--ghost">
        Cotizar proyecto
      </a>
    </div>
  </section>
</MainLayout>
